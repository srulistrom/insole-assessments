# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only - never expose. Used for Google Drive token storage + Drive sync.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used for Google OAuth redirect). e.g. https://insoles.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
# Authorised redirect URI: {NEXT_PUBLIC_SITE_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
